PORT=4000
CLIENT_URL=http://localhost:5173
JWT_SECRET=change-this-jwt-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!
# Prefer ADMIN_PASSWORD_HASH in production. Generate with:
# node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
# ADMIN_PASSWORD_HASH=
MONGODB_URI=mongodb://127.0.0.1:27017
# Optional fallback for networks that block SRV DNS queries used by mongodb+srv URIs.
# MONGODB_DIRECT_URI=mongodb://user:pass@host1:27017,host2:27017,host3:27017/?authSource=admin&replicaSet=yourReplicaSet&tls=true
MONGODB_DB_NAME=suno_blog
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=suno-releases
LOCAL_AI_ENABLED=true
LOCAL_AI_BASE_URL=http://127.0.0.1:11434
LOCAL_AI_MODEL=qwen2.5:7b
# Optional JSON array or object map for admin-facing model profiles.
# LOCAL_AI_MODEL_PROFILES=[{"key":"fast","label":"Fast","model":"qwen2.5:7b"},{"key":"balanced","label":"Balanced","model":"qwen3:14b"},{"key":"thorough","label":"Thorough","model":"qwen3:30b"}]
LOCAL_AI_TIMEOUT_MS=120000
LOCAL_AI_STATUS_CACHE_MS=8000
LOCAL_AI_KEEP_ALIVE=45m
LOCAL_AI_DEFAULT_NUM_CTX=4096
LOCAL_AI_DEFAULT_NUM_PREDICT=320
# Leave at 0 to let Ollama decide. Raise it on stronger remote CPUs if needed.
LOCAL_AI_NUM_THREAD=0
# Lower these if you want faster but shorter assistant responses.
LOCAL_AI_POST_NUM_PREDICT=700
LOCAL_AI_PATH_NUM_PREDICT=850
LOCAL_AI_NEW_PATH_NUM_PREDICT=900
RUNPOD_API_KEY=your_runpod_api_key
RUNPOD_POD_ID=your_runpod_pod_id
RUNPOD_API_BASE_URL=https://rest.runpod.io/v1
# Optional manual override. If blank, the app will discover the current SSH host/port from the RunPod pod API.
RUNPOD_SSH_HOST=
RUNPOD_SSH_PORT=22
RUNPOD_SSH_USER=root
RUNPOD_SSH_KEY_PATH=~/.ssh/id_ed25519
RUNPOD_TUNNEL_LOCAL_PORT=11434
RUNPOD_TUNNEL_REMOTE_HOST=127.0.0.1
RUNPOD_TUNNEL_REMOTE_PORT=11434
REMOTE_OLLAMA_KEEP_ALIVE=45m
# 1 is safest. 2 can improve responsiveness on larger remote GPUs if VRAM allows.
REMOTE_OLLAMA_NUM_PARALLEL=1
IMPORTER_ROOT=D:\Projects\PythonProject
IMPORTER_URL=http://127.0.0.1:8765
# IMPORTER_PYTHON_PATH=D:\Projects\PythonProject\.venv\Scripts\python.exe
VITE_API_URL=http://localhost:4000/api
VITE_IMPORTER_URL=http://127.0.0.1:8765
