# ============================================================
# Frontend environment values
# These are read by Vite in the browser build.
# Set these in Vercel or a frontend-local env file.
# ============================================================
VITE_API_URL=http://localhost:4000/api
VITE_IMPORTER_ENABLED=true
VITE_IMPORTER_URL=http://127.0.0.1:8765

# ============================================================
# Backend: server and browser access
# PORT controls the Express server port. CLIENT_URL is the allowed frontend
# origin for CORS/cookie-backed sessions.
# ============================================================
PORT=4000
CLIENT_URL=http://localhost:5173
ENABLE_REQUEST_LOGGING=false
LOG_LEVEL=info

# ============================================================
# Backend: admin authentication
# Prefer ADMIN_PASSWORD_HASH in production. Generate with:
# node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
# ============================================================
JWT_SECRET=change-this-jwt-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!
# ADMIN_PASSWORD_HASH=

# ============================================================
# Backend: database and authored catalog files
# MongoDB is the live store. POSTS_FILE is the authored seed/source catalog
# used by reseed flows.
# ============================================================
MONGODB_URI=mongodb://127.0.0.1:27017
# Optional fallback for networks that block SRV DNS queries.
# MONGODB_DIRECT_URI=mongodb://user:pass@host1:27017,host2:27017/?authSource=admin&replicaSet=yourReplicaSet&tls=true
MONGODB_DB_NAME=suno_blog
# POSTS_FILE=backend/data/posts.local.json
# OPERATIONAL_SEED_FILE=backend/data/operational-seed.local.json
# ENABLE_CATALOG_FILE_MUTATIONS=true

# ============================================================
# Backend: Cloudinary media uploads
# Used for admin video upload and account avatar upload.
# ============================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=suno-releases
# CLOUDINARY_CHUNK_SIZE=20971520

# ============================================================
# Backend: importer integration
# Lets the admin studio open the local Python importer UI.
# Keep this false/unset on Render. The importer is a local workstation tool,
# unless IMPORTER_LAUNCH_MODE=external points to a separate hosted importer URL.
# ============================================================
IMPORTER_ENABLED=true
# Use local to spawn the bundled Flask importer from this machine.
# Use external when IMPORTER_URL points to a separate hosted importer service.
IMPORTER_LAUNCH_MODE=local
# IMPORTER_ROOT=D:\Docs\Active Project\React Final Project\tools\song-importer
IMPORTER_URL=http://127.0.0.1:8765
# IMPORTER_PYTHON_PATH=D:\Docs\Active Project\React Final Project\tools\song-importer\.venv\Scripts\python.exe

# ============================================================
# Backend: Ollama assistant
# The assistant always talks to Ollama through LOCAL_AI_BASE_URL.
# For Thunder, open the SSH tunnel first so local 11434 forwards to the remote
# Ollama server.
# ============================================================
LOCAL_AI_ENABLED=true
LOCAL_AI_BASE_URL=http://127.0.0.1:11434
LOCAL_AI_MODEL=qwen2.5:7b
# Optional JSON array or object map for admin-facing model profiles.
# LOCAL_AI_MODEL_PROFILES=[{"key":"fast","label":"Fast","model":"qwen2.5:7b"},{"key":"balanced","label":"Balanced","model":"qwen3:14b"},{"key":"thorough","label":"Thorough","model":"qwen3:30b"}]
# Larger models such as qwen3:30b can take several minutes for catalog review.
LOCAL_AI_TIMEOUT_MS=600000
LOCAL_AI_STATUS_CACHE_MS=8000
LOCAL_AI_KEEP_ALIVE=45m
LOCAL_AI_DEFAULT_NUM_CTX=4096
LOCAL_AI_DEFAULT_NUM_PREDICT=320
# Optional Ollama GPU-layer hint. Use 99 on Thunder GPU instances to encourage
# full offload when the model supports it.
LOCAL_AI_DEFAULT_NUM_GPU=99
LOCAL_AI_NUM_THREAD=0
LOCAL_AI_POST_NUM_PREDICT=700
LOCAL_AI_PATH_NUM_PREDICT=850
LOCAL_AI_NEW_PATH_NUM_PREDICT=900

# ============================================================
# Backend: Thunder/manual SSH remote AI controls
# Create or restore the Thunder instance manually. The app only opens/closes
# the SSH tunnel and starts Ollama over SSH. To stop billing, snapshot/delete
# the instance in Thunder.
# ============================================================
REMOTE_AI_ENABLED=true
REMOTE_AI_SSH_HOST=tnr-0
# Leave REMOTE_AI_SSH_PORT and REMOTE_AI_SSH_KEY_PATH blank when REMOTE_AI_SSH_HOST
# is an entry in ~/.ssh/config. This lets Thunder update the real host, port, and
# key in one place after an instance restore.
REMOTE_AI_SSH_PORT=
REMOTE_AI_SSH_USER=ubuntu
REMOTE_AI_SSH_KEY_PATH=
REMOTE_AI_TUNNEL_LOCAL_PORT=11434
REMOTE_AI_TUNNEL_REMOTE_HOST=127.0.0.1
REMOTE_AI_TUNNEL_REMOTE_PORT=11434
REMOTE_AI_OLLAMA_MODELS_PATH=/home/ubuntu/ollama-models
REMOTE_AI_OLLAMA_LOG_PATH=/home/ubuntu/ollama.log
