{
  "name": "react-final-project",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "lint": "eslint \"backend/src/**/*.js\" \"backend/scripts/**/*.js\" \"backend/test/**/*.js\" \"frontend/src/**/*.{js,jsx}\" \"e2e/**/*.js\" \"*.js\"",
    "format": "prettier --write \"*.{js,json,md}\" \".github/**/*.yml\" \"backend/package.json\" \"backend/scripts/start-test-server.js\" \"backend/test/**/*.js\" \"frontend/package.json\" \"frontend/src/lib/site.test.js\" \"e2e/**/*.js\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"*.{js,json,md}\" \".github/**/*.yml\" \"backend/package.json\" \"backend/scripts/start-test-server.js\" \"backend/test/**/*.js\" \"frontend/package.json\" \"frontend/src/lib/site.test.js\" \"e2e/**/*.js\" \"docs/**/*.md\"",
    "test:unit": "npm run test:unit --prefix backend && npm run test:unit --prefix frontend",
    "test:api": "npm run test:api --prefix backend",
    "test:e2e": "playwright test",
    "verify": "npm run verify --prefix backend && npm run verify --prefix frontend",
    "ci": "npm run lint && npm run format:check && npm run test:unit && npm run test:api && npm run verify && npm run test:e2e",
    "sitemap": "node tools/generate-sitemap.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "prettier": "^3.8.3"
  }
}
